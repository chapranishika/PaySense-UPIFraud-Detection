<?xml version="1.0" encoding="utf-8"?>
<!-- Fill for the "Why is this risky?" magnitude bars. Base white — tinted at
     runtime per-row via View.backgroundTintList (colorAlertNone/Low/Medium/High)
     so the bar colour always matches the row's real derived risk level. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="@android:color/white" />
</shape>
