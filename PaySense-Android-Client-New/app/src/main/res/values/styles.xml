<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Category selector chip — vivid filled state, soft lavender at rest. -->
    <style name="PaySenseChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">13sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- Big expressive headline used for brand wordmarks / large money amounts -->
    <style name="PaySenseHeadline">
        <item name="android:fontFamily">@font/poppins_extrabold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Section title used above card groups ("Recent transactions", etc.) -->
    <style name="PaySenseSectionTitle">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
