# ─────────────────────────────────────────────────
# PaySense Guardian — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# JWT signing secret — change this to a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=paysense-dev-secret-change-in-prod

# Token expiry in minutes (default: 60)
TOKEN_EXPIRE_MIN=60

# Demo API credentials (what /auth/token accepts)
API_DEMO_USER=paysense
API_DEMO_PASS=guardian2025

# App environment. IMPORTANT: "development" makes /predict, /classify, and
# /insights/weekly skip JWT auth entirely when no Authorization header is
# sent — it exists for local curl/testing convenience, not for a deployed
# server. The Android client now performs real login via /auth/token and
# sends a real Bearer token on every request, so it no longer depends on
# this bypass. Set to "production" here and on Render/cloud; only use
# "development" on your own machine when you're testing without a token.
APP_ENV=production

# Gemini API key (optional) — enables AI savings tips in /insights/weekly
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CORS allowed origins (comma-separated, use * for dev)
ALLOWED_ORIGINS=*

# Port (injected automatically by Render — don't set this on Render)
# PORT=8000
